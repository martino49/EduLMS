<div class="row mb-4">
    <div class="col-md-12">
        <div class="card bg-white border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h4 class="card-title fw-bold mb-4">Record Manual Payment</h4>
                <p class="text-muted">Enter payment details manually for cash, bank transfers, or other offline payment
                    methods.</p>

                <% if (locals.errors) { %>
                    <div class="alert alert-danger rounded-3">
                        <ul class="mb-0 ps-3">
                            <% errors.forEach(function(error) { %>
                                <li>
                                    <%= error.msg %>
                                </li>
                                <% }); %>
                        </ul>
                    </div>
                    <% } %>

                        <form action="/finance/payments/manual/process" method="POST" class="needs-validation"
                            novalidate>
                            <div class="row g-3">
                                <!-- Student Selection -->
                                <div class="col-md-6">
                                    <label for="student_id" class="form-label fw-semibold">Student ID / Name</label>
                                    <% if (locals.student && student) { %>
                                        <div class="input-group">
                                            <input type="text" class="form-control"
                                                value="<%= student.name %> (<%= student.student_id %>)" disabled>
                                            <input type="hidden" name="student_id" value="<%= student.id %>">
                                            <a href="/finance/payments/manual-entry"
                                                class="btn btn-outline-secondary">Change</a>
                                        </div>
                                        <% } else { %>
                                            <div class="input-group">
                                                <input type="text" class="form-control"
                                                    placeholder="Search for student..." id="student_search" required>
                                                <button class="btn btn-outline-primary" type="button"
                                                    id="search_btn">Search</button>
                                                <div class="invalid-feedback">Please select a student.</div>
                                            </div>
                                            <div id="search_results"
                                                class="list-group position-absolute w-100 shadow-sm"
                                                style="z-index: 1000; top: 100%;"></div>
                                            <input type="hidden" name="student_id" id="selected_student_id" required>
                                            <% } %>
                                </div>

                                <!-- Fee Structure Selection -->
                                <div class="col-md-6">
                                    <label for="fee_structure_id" class="form-label fw-semibold">Fee Type</label>
                                    <select class="form-select" id="fee_structure_id" name="fee_structure_id" required>
                                        <option value="" selected disabled>Select Fee Type</option>
                                        <% if (locals.feeStructures) { %>
                                            <% feeStructures.forEach(function(fee) { %>
                                                <option value="<%= fee.id %>" data-amount="<%= fee.amount %>">
                                                    <%= fee.name %> (<%= fee.fee_type.replace('_', ' ' ) %>) - KES <%=
                                                                fee.amount %>
                                                </option>
                                                <% }); %>
                                                    <% } %>
                                    </select>
                                    <div class="invalid-feedback">Please select a fee type.</div>
                                </div>

                                <!-- Amount -->
                                <div class="col-md-6">
                                    <label for="amount" class="form-label fw-semibold">Amount (KES)</label>
                                    <input type="number" class="form-control" id="amount" name="amount" min="1"
                                        step="0.01" required value="<%= locals.formData ? formData.amount : '' %>">
                                    <div class="form-text">Enter the amount paid by the student.</div>
                                    <div class="invalid-feedback">Please enter a valid amount.</div>
                                </div>

                                <!-- Payment Method -->
                                <div class="col-md-6">
                                    <label for="payment_method" class="form-label fw-semibold">Payment Method</label>
                                    <select class="form-select" id="payment_method" name="payment_method" required>
                                        <option value="" selected disabled>Select Method</option>
                                        <option value="cash" <%=locals.formData && formData.payment_method==='cash'
                                            ? 'selected' : '' %>>Cash</option>
                                        <option value="bank_transfer" <%=locals.formData &&
                                            formData.payment_method==='bank_transfer' ? 'selected' : '' %>>Bank Transfer
                                        </option>
                                        <option value="cheque" <%=locals.formData && formData.payment_method==='cheque'
                                            ? 'selected' : '' %>>Cheque</option>
                                        <option value="card" <%=locals.formData && formData.payment_method==='card'
                                            ? 'selected' : '' %>>Card</option>
                                    </select>
                                    <div class="invalid-feedback">Please select a payment method.</div>
                                </div>

                                <!-- Transaction Reference / Receipt Number -->
                                <div class="col-md-6">
                                    <label for="receipt_number" class="form-label fw-semibold">Receipt No. / Ref
                                        ID</label>
                                    <input type="text" class="form-control" id="receipt_number" name="receipt_number"
                                        placeholder="Optional"
                                        value="<%= locals.formData ? formData.receipt_number : '' %>">
                                    <div class="form-text">Bank reference, cheque number, or internal receipt ID.</div>
                                </div>

                                <!-- Notes -->
                                <div class="col-12">
                                    <label for="notes" class="form-label fw-semibold">Notes / Remarks</label>
                                    <textarea class="form-control" id="notes" name="notes" rows="3"
                                        placeholder="Optional remarks..."><%= locals.formData ? formData.notes : '' %></textarea>
                                </div>

                                <div class="col-12 mt-4 text-end">
                                    <a href="/finance/payments" class="btn btn-light me-2">Cancel</a>
                                    <button type="submit" class="btn btn-primary px-4">
                                        <i class="fas fa-save me-2"></i>Record Payment
                                    </button>
                                </div>
                            </div>
                        </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Simple client-side search simulation (in a real app, use AJAX)
    const searchBtn = document.getElementById('search_btn');
    const studentSearch = document.getElementById('student_search');
    const searchResults = document.getElementById('search_results');
    const selectedStudentId = document.getElementById('selected_student_id');

    // Pre-fill amount when fee type changes
    document.getElementById('fee_structure_id').addEventListener('change', function () {
        const selectedOption = this.options[this.selectedIndex];
        const amount = selectedOption.getAttribute('data-amount');
        if (amount) {
            document.getElementById('amount').value = amount;
        }
    });

    // Example AJAX search (placeholder logic)
    if (searchBtn) {
        searchBtn.addEventListener('click', function () {
            const query = studentSearch.value;
            if (query.length < 2) {
                alert('Please enter at least 2 characters');
                return;
            }

            // In a real implementation:
            fetch(`/api/students/search?q=${query}`)
                .then(response => response.json())
                .then(data => {
                    // Render results
                    searchResults.innerHTML = '';
                    data.forEach(student => {
                        const item = document.createElement('a');
                        item.classList.add('list-group-item', 'list-group-item-action');
                        item.innerHTML = `<strong>${student.name}</strong> (${student.student_id})`;
                        item.addEventListener('click', () => {
                            studentSearch.value = student.name;
                            selectedStudentId.value = student.id;
                            searchResults.innerHTML = '';
                        });
                        searchResults.appendChild(item);
                    });
                });
            // Fallback for this demo since API doesn't exist
            alert('Search functionality requires backend API implementation. Please enter student ID manually if needed.');
        });
    }
</script>