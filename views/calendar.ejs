<div class="row mb-5 text-center">
    <div class="col-lg-8 mx-auto">
        <h1 class="display-4 fw-bold mb-3">Academic Calendar</h1>
        <p class="lead text-muted">Important dates, deadlines, and holidays for the academic year.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Upcoming Events</h5>
                <div>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill me-1"><i
                            class="fas fa-chevron-left"></i></button>
                    <span class="fw-bold mx-2">October 2024</span>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill"><i
                            class="fas fa-chevron-right"></i></button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush rounded-bottom-4">
                    <div class="list-group-item p-4 border-0 border-bottom">
                        <div class="row align-items-center">
                            <div class="col-auto text-center pe-4 border-end">
                                <h3 class="fw-bold text-primary mb-0">15</h3>
                                <span class="text-uppercase small fw-bold text-muted">Oct</span>
                            </div>
                            <div class="col ps-4">
                                <h6 class="fw-bold mb-1">Fall Semester Mid-Terms Begin</h6>
                                <p class="text-muted small mb-0">All Undergraduate Programs</p>
                            </div>
                            <div class="col-auto">
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3">Academic</span>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item p-4 border-0 border-bottom">
                        <div class="row align-items-center">
                            <div class="col-auto text-center pe-4 border-end">
                                <h3 class="fw-bold text-danger mb-0">28</h3>
                                <span class="text-uppercase small fw-bold text-muted">Oct</span>
                            </div>
                            <div class="col ps-4">
                                <h6 class="fw-bold mb-1">Course Withdrawal Deadline</h6>
                                <p class="text-muted small mb-0">Last day to withdraw without academic penalty</p>
                            </div>
                            <div class="col-auto">
                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Deadline</span>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item p-4 border-0 border-bottom">
                        <div class="row align-items-center">
                            <div class="col-auto text-center pe-4 border-end">
                                <h3 class="fw-bold text-success mb-0">05</h3>
                                <span class="text-uppercase small fw-bold text-muted">Nov</span>
                            </div>
                            <div class="col ps-4">
                                <h6 class="fw-bold mb-1">Registration Opens for Spring 2025</h6>
                                <p class="text-muted small mb-0">Returning students priority registration</p>
                            </div>
                            <div class="col-auto">
                                <span
                                    class="badge bg-success-subtle text-success rounded-pill px-3">Administrative</span>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item p-4 border-0">
                        <div class="row align-items-center">
                            <div class="col-auto text-center pe-4 border-end">
                                <h3 class="fw-bold text-info mb-0">20</h3>
                                <span class="text-uppercase small fw-bold text-muted">Nov</span>
                            </div>
                            <div class="col ps-4">
                                <h6 class="fw-bold mb-1">Campus Career Fair</h6>
                                <p class="text-muted small mb-0">Student Union Hall</p>
                            </div>
                            <div class="col-auto">
                                <span class="badge bg-info-subtle text-info rounded-pill px-3">Event</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white">
            <div class="card-body p-4">
                <i class="fas fa-file-download fa-3x mb-3 text-white-50"></i>
                <h5 class="fw-bold">Download Calendar</h5>
                <p class="small text-white-50 mb-4">Get the full academic year calendar in PDF format for offline
                    viewing.</p>
                <button class="btn btn-light rounded-pill w-100 fw-bold text-primary">Download PDF</button>
            </div>
        </div>

        <h5 class="fw-bold mb-3">Key Dates</h5>
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <tbody>
                        <tr>
                            <td class="ps-4 py-3 text-muted">Semester Start</td>
                            <td class="pe-4 py-3 text-end fw-bold">Sep 01, 2024</td>
                        </tr>
                        <tr>
                            <td class="ps-4 py-3 text-muted">Winter Break</td>
                            <td class="pe-4 py-3 text-end fw-bold">Dec 20 - Jan 05</td>
                        </tr>
                        <tr>
                            <td class="ps-4 py-3 text-muted">Spring Start</td>
                            <td class="pe-4 py-3 text-end fw-bold">Jan 15, 2025</td>
                        </tr>
                        <tr>
                            <td class="ps-4 py-3 text-muted">Graduation</td>
                            <td class="pe-4 py-3 text-end fw-bold">May 30, 2025</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>