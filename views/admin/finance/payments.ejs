<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Payment Management</h1>
        <div class="header-actions">
            <button class="btn btn-outline-primary me-2">
                <i class="fas fa-download me-2"></i>Export Report
            </button>
            <button class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Record Manual Payment
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small mb-1">Total Transactions</div>
                    <h4 class="mb-0">
                        <%= payments.length %>
                    </h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small mb-1">Total Revenue</div>
                    <h4 class="mb-0 text-success">
                        KES <%= payments.reduce((acc, p)=> acc + (p.status === 'completed' ? parseFloat(p.amount) : 0),
                            0).toLocaleString() %>
                    </h4>
                </div>
            </div>
        </div>
    </div>

    <% if (payments && payments.length> 0) { %>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Transaction ID</th>
                                <th>Student</th>
                                <th>Fee Category</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th class="pe-4 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% payments.forEach(payment=> { %>
                                <tr>
                                    <td class="ps-4">
                                        <span class="text-monospace">#<%= payment.id.toString().padStart(6, '0' ) %>
                                                </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold">
                                            <%= payment.student_name %>
                                        </div>
                                        <div class="small text-muted">
                                            <%= payment.student_id %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= payment.fee_structure_name || 'General' %>
                                    </td>
                                    <td class="fw-bold text-dark">
                                        KES <%= parseFloat(payment.amount).toLocaleString() %>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <%= payment.payment_method || 'M-Pesa' %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge <%= 
                                            payment.status === 'completed' ? 'bg-success-light text-success' : 
                                            payment.status === 'pending' ? 'bg-warning-light text-warning' : 
                                            'bg-danger-light text-danger' 
                                        %>">
                                            <i class="fas fa-circle font-size-xs me-1"></i>
                                            <%= payment.status.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td class="text-muted small">
                                        <%= new Date(payment.created_at).toLocaleString() %>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-icon hover-primary" title="View Receipt">
                                                <i class="fas fa-file-invoice"></i>
                                            </button>
                                            <button class="btn btn-sm btn-icon hover-danger" title="Void Transaction">
                                                <i class="fas fa-times-circle"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <% } else { %>
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="mb-3">
                        <i class="fas fa-receipt fa-3x text-light"></i>
                    </div>
                    <h5 class="text-dark">No Payments Found</h5>
                    <p class="text-muted">There are no payment records to display at this time.</p>
                </div>
            </div>
            <% } %>
</div>

<style>
    .bg-success-light {
        background-color: rgba(28, 200, 138, 0.1);
    }

    .bg-warning-light {
        background-color: rgba(246, 194, 62, 0.1);
    }

    .bg-danger-light {
        background-color: rgba(231, 74, 59, 0.1);
    }

    .text-monospace {
        font-family: 'Courier New', Courier, monospace;
    }

    .btn-icon {
        color: #858796;
        border: none;
        background: transparent;
    }

    .hover-primary:hover {
        color: #4e73df;
    }

    .hover-danger:hover {
        color: #e74a3b;
    }

    .font-size-xs {
        font-size: 0.6rem;
    }
</style>