<div class="admin-profile-container">
    <div class="profile-header">
        <div class="profile-cover"></div>
        <div class="profile-info-card">
            <div class="profile-avatar-wrapper">
                <% if (user.profile_image) { %>
                    <img src="<%= user.profile_image %>" alt="<%= user.name %>" class="profile-avatar">
                    <% } else { %>
                        <div class="profile-avatar-initials">
                            <%= user.initials %>
                        </div>
                        <% } %>
            </div>
            <div class="profile-main-info">
                <h1>
                    <%= user.name %>
                </h1>
                <p class="role-badge">
                    <%= user.role_name.toUpperCase() %>
                </p>
                <p class="user-email"><i class="fas fa-envelope"></i>
                    <%= user.email %>
                </p>
            </div>
            <div class="profile-actions">
                <a href="/admin/users/<%= user.id %>/edit" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Edit Profile
                </a>
            </div>
        </div>
    </div>

    <div class="profile-content">
        <div class="row">
            <div class="col-md-4">
                <div class="content-card">
                    <h3>Account Information</h3>
                    <div class="info-list">
                        <div class="info-item">
                            <span class="label">Username:</span>
                            <span class="value">
                                <%= user.username %>
                            </span>
                        </div>
                        <div class="info-item">
                            <span class="label">User ID:</span>
                            <span class="value">#<%= user.id %></span>
                        </div>
                        <div class="info-item">
                            <span class="label">Status:</span>
                            <span class="value status-<%= user.status %>">
                                <%= user.status %>
                            </span>
                        </div>
                        <div class="info-item">
                            <span class="label">Joined:</span>
                            <span class="value">
                                <%= new Date(user.created_at).toLocaleDateString() %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="content-card">
                    <h3>Recent Activity</h3>
                    <p class="text-muted text-center py-5">Activity logs feature coming soon.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-profile-container {
        padding: 2rem;
    }

    .profile-header {
        position: relative;
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        margin-bottom: 2rem;
    }

    .profile-cover {
        height: 150px;
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }

    .profile-info-card {
        padding: 0 2rem 2rem;
        display: flex;
        align-items: flex-end;
        gap: 2rem;
        margin-top: -50px;
        position: relative;
    }

    .profile-avatar-wrapper {
        width: 150px;
        height: 150px;
        border-radius: 1rem;
        background: white;
        padding: 5px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    .profile-avatar {
        width: 100%;
        height: 100%;
        border-radius: 0.8rem;
        object-fit: cover;
    }

    .profile-avatar-initials {
        width: 100%;
        height: 100%;
        border-radius: 0.8rem;
        background: #f1f5f9;
        color: #1e293b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: 700;
    }

    .profile-main-info {
        flex: 1;
        padding-bottom: 0.5rem;
    }

    .profile-main-info h1 {
        margin: 0;
        font-size: 1.875rem;
        color: #0f172a;
    }

    .role-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: #e2e8f0;
        color: #475569;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 600;
        margin: 0.5rem 0;
    }

    .user-email {
        color: #64748b;
        margin: 0;
    }

    .content-card {
        background: white;
        padding: 1.5rem;
        border-radius: 1rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        height: 100%;
    }

    .content-card h3 {
        font-size: 1.125rem;
        color: #1e293b;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .info-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        font-size: 0.875rem;
    }

    .info-item .label {
        color: #64748b;
        font-weight: 500;
    }

    .info-item .value {
        color: #1e293b;
        font-weight: 600;
    }

    .status-active {
        color: #10b981;
    }

    .status-inactive {
        color: #ef4444;
    }

    @media (max-width: 768px) {
        .profile-info-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding-top: 0;
        }

        .profile-avatar-wrapper {
            margin-top: -75px;
        }

        .profile-actions {
            width: 100%;
            margin-top: 1rem;
        }
    }
</style>