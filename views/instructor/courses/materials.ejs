<%- include('../../../layouts/instructor-layout', { title: title, pageTitle: pageTitle, currentPage: 'courses' ,
    breadcrumbs: breadcrumbs, headerActions: [ { url: `/instructor/courses/${course.id}`, text: 'Course Overview' ,
    icon: 'fas fa-eye' , class: 'btn-outline-primary' } ] }) %>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold text-uppercase small">Upload Material</h5>
                </div>
                <div class="card-body">
                    <form action="/instructor/courses/<%= course.id %>/materials" method="POST"
                        enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Title</label>
                            <input type="text" name="title" class="form-control"
                                placeholder="e.g. Lecture 1: Introduction" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Description</label>
                            <textarea name="description" class="form-control" rows="3"
                                placeholder="Brief overview of the content..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Resource File</label>
                            <input type="file" name="material_file" class="form-control" required>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-cloud-upload-alt me-2"></i>Upload Resource
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold text-uppercase small">Material Repository</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Material</th>
                                    <th>Type</th>
                                    <th>Added Date</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (materials && materials.length> 0) { %>
                                    <% materials.forEach(material=> { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-file-pdf text-danger fa-lg me-3"></i>
                                                    <div>
                                                        <div class="fw-bold text-dark">
                                                            <%= material.title %>
                                                        </div>
                                                        <small class="text-muted">
                                                            <%= material.description || 'No description' %>
                                                        </small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="badge bg-light text-dark border">
                                                    <%= material.file_type || 'Document' %>
                                                </span></td>
                                            <td>
                                                <%= new Date(material.created_at).toLocaleDateString() %>
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="btn-group">
                                                    <a href="/<%= material.file_path %>"
                                                        class="btn btn-sm btn-light border" target="_blank">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                    <button class="btn btn-sm btn-light border text-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="4" class="text-center py-5 text-muted">
                                                        <i class="fas fa-folder-open d-block mb-2 fa-2x"></i>
                                                        No materials uploaded for this course yet.
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>