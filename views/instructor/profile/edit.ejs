<%- include('../../../layouts/instructor-layout', { title: title, pageTitle: pageTitle, currentPage: 'profile' ,
    breadcrumbs: breadcrumbs }) %>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold text-uppercase small text-primary">Personal Information</h6>
                </div>
                <div class="card-body p-4">
                    <form action="/instructor/profile" method="POST">
                        <div class="row g-3">
                            <div class="col-md-6 text-center mb-3">
                                <div class="position-relative d-inline-block">
                                    <img src="<%= profile.profile_image || '/img/default-avatar.png' %>"
                                        class="rounded-circle border"
                                        style="width: 120px; height: 120px; object-fit: cover;">
                                    <button type="button"
                                        class="btn btn-sm btn-primary position-absolute bottom-0 end-0 rounded-circle">
                                        <i class="fas fa-camera"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Full Name</label>
                                    <input type="text" name="name" class="form-control" value="<%= profile.name %>"
                                        required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Email Address</label>
                                    <input type="email" name="email" class="form-control" value="<%= profile.email %>"
                                        required>
                                    <div class="form-text">Used for login and correspondence.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Phone Number</label>
                                <input type="text" name="phone" class="form-control" value="<%= profile.phone || '' %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Biography</label>
                                <textarea name="bio" class="form-control" rows="5"
                                    placeholder="Share your professional background and teaching philosophy..."><%= profile.bio || '' %></textarea>
                            </div>
                            <div class="col-12 pt-3">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/instructor/profile" class="btn btn-light border px-4">Cancel</a>
                                    <button type="submit" class="btn btn-primary px-5 fw-bold">Update Profile</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>