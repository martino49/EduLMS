<%- include('../../../layouts/instructor-layout', { title: title, pageTitle: pageTitle, currentPage: 'assignments' ,
    breadcrumbs: breadcrumbs, headerActions: [ { url: `/instructor/assignments/${assignment.id}/edit`,
    text: 'Edit Assignment' , icon: 'fas fa-edit' , class: 'btn-outline-primary' } ] }) %>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold text-uppercase small">Assignment Details</h5>
                </div>
                <div class="card-body">
                    <h3 class="h4 mb-3 font-outfit">
                        <%= assignment.title %>
                    </h3>
                    <div class="mb-4">
                        <span class="badge bg-soft-primary text-primary me-2">
                            <%= assignment.course_code %>
                        </span>
                        <span class="badge bg-<%= assignment.status === 'published' ? 'success' : 'secondary' %>">
                            <%= assignment.status.toUpperCase() %>
                        </span>
                    </div>

                    <h6 class="fw-bold text-muted mb-2 small text-uppercase">Description</h6>
                    <div class="p-3 bg-light rounded border mb-4">
                        <%- assignment.description || 'No description provided.' %>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-4">
                            <div class="p-3 border rounded text-center">
                                <small class="text-muted d-block uppercase small mb-1">Max Points</small>
                                <span class="h5 mb-0 fw-bold">
                                    <%= assignment.max_points %>
                                </span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 border rounded text-center">
                                <small class="text-muted d-block uppercase small mb-1">Due Date</small>
                                <span class="h6 mb-0 fw-bold d-block">
                                    <%= new Date(assignment.due_date).toLocaleDateString() %>
                                </span>
                                <small class="text-danger">
                                    <%= new Date(assignment.due_date).toLocaleTimeString([], {hour: '2-digit' ,
                                        minute:'2-digit'}) %>
                                </small>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 border rounded text-center">
                                <small class="text-muted d-block uppercase small mb-1">Submissions</small>
                                <span class="h5 mb-0 fw-bold">
                                    <%= submissions.length %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submissions List -->
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold text-uppercase small">Submissions</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Student</th>
                                    <th>Submitted On</th>
                                    <th>Status</th>
                                    <th>Grade</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (submissions && submissions.length> 0) { %>
                                    <% submissions.forEach(submission=> { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">
                                                    <%= submission.student_name %>
                                                </div>
                                                <small class="text-muted">ID: <%= submission.student_id %></small>
                                            </td>
                                            <td>
                                                <%= new Date(submission.submitted_at).toLocaleString() %>
                                            </td>
                                            <td>
                                                <span
                                                    class="badge bg-<%= submission.status === 'graded' ? 'success' : 'warning' %>">
                                                    <%= submission.status %>
                                                </span>
                                            </td>
                                            <td>
                                                <% if (submission.grade) { %>
                                                    <span class="fw-bold text-primary">
                                                        <%= submission.grade %>/<%= assignment.max_points %>
                                                    </span>
                                                    <% } else { %>
                                                        <span class="text-muted">Pending</span>
                                                        <% } %>
                                            </td>
                                            <td class="text-end pe-4">
                                                <a href="/instructor/submissions/<%= submission.id %>/grade"
                                                    class="btn btn-sm btn-primary">
                                                    <i class="fas fa-award me-1"></i>Grade
                                                </a>
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="5" class="text-center py-4 text-muted">No submissions
                                                        found.</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Sidebar -->
        <div class="col-md-4">
            <div class="card shadow-sm border-primary mb-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Quick Actions</h6>
                    <div class="d-grid gap-2">
                        <% if (assignment.status==='draft' ) { %>
                            <form action="/instructor/assignments/<%= assignment.id %>/publish" method="POST">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fas fa-paper-plane me-2"></i>Publish Assignment
                                </button>
                            </form>
                            <% } %>
                                <a href="/instructor/submissions?assignmentId=<%= assignment.id %>"
                                    class="btn btn-outline-primary">
                                    <i class="fas fa-download me-2"></i>Download All
                                </a>
                                <button class="btn btn-outline-danger" data-bs-toggle="modal"
                                    data-bs-target="#deleteModal">
                                    <i class="fas fa-trash me-2"></i>Delete Assignment
                                </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .bg-soft-primary {
            background-color: rgba(13, 110, 253, 0.1);
        }

        .font-outfit {
            font-family: 'Outfit', sans-serif;
        }
    </style>