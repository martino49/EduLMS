<%- include('../../../layouts/instructor-layout', { title: title, pageTitle: pageTitle, currentPage: 'assignments' ,
    breadcrumbs: breadcrumbs, headerActions: [ { url: '/instructor/assignments/create' , text: 'New Assignment' ,
    icon: 'fas fa-plus' , class: 'btn-primary' } ] }) %>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <form class="row g-3 align-items-center">
                <div class="col-md-4">
                    <select name="courseId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">All Courses</option>
                        <% courses.forEach(course=> { %>
                            <option value="<%= course.id %>" <%=filters.courseId==course.id ? 'selected' : '' %>>
                                <%= course.course_code %>: <%= course.title %>
                            </option>
                            <% }); %>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        <option value="draft" <%=filters.status==='draft' ? 'selected' : '' %>>Draft</option>
                        <option value="published" <%=filters.status==='published' ? 'selected' : '' %>>Published
                        </option>
                        <option value="closed" <%=filters.status==='closed' ? 'selected' : '' %>>Closed</option>
                    </select>
                </div>
            </form>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Assignment Title</th>
                            <th>Course</th>
                            <th>Due Date</th>
                            <th>Submissions</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (assignments && assignments.length> 0) { %>
                            <% assignments.forEach(assignment=> { %>
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">
                                            <%= assignment.title %>
                                        </div>
                                        <small class="text-muted">
                                            <%= assignment.description ? assignment.description.substring(0, 50) + '...'
                                                : 'No description' %>
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <%= assignment.course_code %>
                                        </span>
                                    </td>
                                    <td>
                                        <%= new Date(assignment.due_date).toLocaleDateString() %>
                                    </td>
                                    <td>
                                        <a href="/instructor/submissions?assignmentId=<%= assignment.id %>"
                                            class="text-decoration-none">
                                            <span class="badge bg-soft-info text-info">
                                                <%= assignment.submission_count %> Submissions
                                            </span>
                                        </a>
                                    </td>
                                    <td>
                                        <span
                                            class="badge bg-<%= assignment.status === 'published' ? 'success' : (assignment.status === 'draft' ? 'secondary' : 'danger') %>">
                                            <%= assignment.status.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a href="/instructor/assignments/<%= assignment.id %>"
                                                class="btn btn-sm btn-light border" title="View">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="/instructor/assignments/<%= assignment.id %>/edit"
                                                class="btn btn-sm btn-light border" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">
                                                <i class="fas fa-tasks d-block mb-2 fa-2x"></i>
                                                No assignments found matching your criteria.
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <style>
        .bg-soft-info {
            background-color: rgba(13, 202, 240, 0.1);
        }
    </style>