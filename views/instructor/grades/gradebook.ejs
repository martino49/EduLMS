<%- include('../../../layouts/instructor-layout', { title: title, pageTitle: pageTitle, currentPage: 'gradebook' ,
    breadcrumbs: breadcrumbs }) %>

    <div class="row mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <label class="form-label fw-bold text-muted small text-uppercase mb-2">Select Course</label>
                    <form action="/instructor/gradebook" method="GET">
                        <select name="courseId" class="form-select" onchange="this.form.submit()">
                            <option value="">Choose a course...</option>
                            <% courses.forEach(course=> { %>
                                <option value="<%= course.id %>" <%=selectedCourse && selectedCourse.id==course.id
                                    ? 'selected' : '' %>>
                                    <%= course.course_code %>: <%= course.title %>
                                </option>
                                <% }); %>
                        </select>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <% if (selectedCourse) { %>
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold text-uppercase small">Grade Matrix: <%=
                            selectedCourse.course_code %>
                    </h5>
                    <button class="btn btn-sm btn-outline-primary" onclick="window.print()">
                        <i class="fas fa-print me-2"></i>Print Report
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0 text-center">
                        <thead class="table-light">
                            <tr>
                                <th class="text-start ps-4 sticky-col">Student Name</th>
                                <% assignments.forEach(assignment=> { %>
                                    <th style="min-width: 120px;">
                                        <div class="small fw-bold">
                                            <%= assignment.title %>
                                        </div>
                                        <small class="text-muted">
                                            <%= assignment.max_points %> Pts
                                        </small>
                                    </th>
                                    <% }); %>
                                        <th class="bg-primary text-white" style="min-width: 100px;">Course Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (students.length> 0) { %>
                                <% students.forEach(student=> {
                                    let totalPoints = 0;
                                    let maxTotal = 0;
                                    %>
                                    <tr>
                                        <td class="text-start ps-4 fw-bold text-dark sticky-col">
                                            <%= student.name %>
                                        </td>
                                        <% assignments.forEach(assignment=> {
                                            const grade = (gradeData[student.id] &&
                                            gradeData[student.id][assignment.id]) || null;
                                            if (grade !== null) totalPoints += parseFloat(grade);
                                            maxTotal += parseFloat(assignment.max_points);
                                            %>
                                            <td>
                                                <% if (grade !==null) { %>
                                                    <span class="fw-bold">
                                                        <%= grade %>
                                                    </span>
                                                    <% } else { %>
                                                        <span class="text-muted">--</span>
                                                        <% } %>
                                            </td>
                                            <% }); %>
                                                <td class="bg-light fw-bold text-primary">
                                                    <%= totalPoints %> / <%= maxTotal %>
                                                            <div class="progress mt-1" style="height: 4px;">
                                                                <div class="progress mt-1" style="height: 4px;">
                                                                    <div class="progress-bar"
                                                                        style="width: <%= maxTotal > 0 ? (totalPoints/maxTotal)*100 : 0 %>%;">
                                                                    </div>
                                                                </div>
                                                            </div>
                </div>
                </td>
                </tr>
                <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="<%= assignments.length + 2 %>" class="py-5 text-muted text-center italic">
                                No students enrolled in this course yet.
                            </td>
                        </tr>
                        <% } %>
                            </tbody>
                            </table>
            </div>
        </div>
        </div>
        <% } else { %>
            <div class="card shadow-sm border-0 py-5 text-center">
                <div class="card-body">
                    <i class="fas fa-book fa-3x text-light mb-3"></i>
                    <h5 class="text-muted">Please select a course to view the gradebook</h5>
                </div>
            </div>
            <% } %>

                <style>
                    .sticky-col {
                        position: sticky;
                        left: 0;
                        background: white;
                        z-index: 1;
                        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.05);
                    }

                    .smaller {
                        font-size: 0.75rem;
                    }
                </style>