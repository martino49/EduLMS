<div class="row mb-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1">My Assignments</h4>
                <p class="text-muted mb-0">Track your tasks and submissions</p>
            </div>
            <div class="d-flex gap-2">
                <select class="form-select border-0 shadow-sm" style="width: auto;">
                    <option value="all">All Status</option>
                    <option value="pending">Pending</option>
                    <option value="submitted">Submitted</option>
                    <option value="graded">Graded</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Assignment</th>
                        <th>Course</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Grade</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (locals.assignments && assignments.length> 0) { %>
                        <% assignments.forEach(function(assignment) { %>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-square bg-primary-subtle text-primary rounded-3 me-3 d-flex align-items-center justify-content-center"
                                            style="width: 40px; height: 40px;">
                                            <i class="fas fa-file-alt"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">
                                                <%= assignment.title %>
                                            </div>
                                            <div class="small text-muted">
                                                <%= assignment.max_points %> Points
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <%= assignment.course_code %>
                                    </span>
                                    <div class="small text-muted mt-1">
                                        <%= assignment.course_title %>
                                    </div>
                                </td>
                                <td>
                                    <% const dueDate=new Date(assignment.due_date); const isOverdue=dueDate < new Date()
                                        && !assignment.submission_status; %>
                                        <div class="<%= isOverdue ? 'text-danger fw-bold' : '' %>">
                                            <%= dueDate.toLocaleDateString() %>
                                        </div>
                                        <div class="small text-muted">
                                            <%= dueDate.toLocaleTimeString([], {hour: '2-digit' , minute:'2-digit'}) %>
                                        </div>
                                </td>
                                <td>
                                    <% if (assignment.submission_status==='graded' ) { %>
                                        <span
                                            class="badge bg-success-subtle text-success rounded-pill px-3">Graded</span>
                                        <% } else if (assignment.submission_status==='submitted' ) { %>
                                            <span
                                                class="badge bg-info-subtle text-info rounded-pill px-3">Submitted</span>
                                            <% } else if (isOverdue) { %>
                                                <span
                                                    class="badge bg-danger-subtle text-danger rounded-pill px-3">Missing</span>
                                                <% } else { %>
                                                    <span
                                                        class="badge bg-warning-subtle text-warning rounded-pill px-3">Pending</span>
                                                    <% } %>
                                </td>
                                <td>
                                    <% if (assignment.grade) { %>
                                        <span class="fw-bold text-dark">
                                            <%= assignment.points_earned %>
                                        </span> <span class="text-muted small">/ <%= assignment.max_points %></span>
                                        <% } else { %>
                                            <span class="text-muted">–</span>
                                            <% } %>
                                </td>
                                <td class="text-end pe-4">
                                    <% if (!assignment.submission_status && !isOverdue) { %>
                                        <a href="/student/assignments/<%= assignment.id %>"
                                            class="btn btn-sm btn-primary px-3 rounded-pill">Submit</a>
                                        <% } else { %>
                                            <a href="/student/assignments/<%= assignment.id %>"
                                                class="btn btn-sm btn-outline-secondary px-3 rounded-pill">View</a>
                                            <% } %>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="fas fa-clipboard-check fa-3x mb-3 text-light-emphasis"></i>
                                                <p class="mb-0">No assignments found.</p>
                                            </div>
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>