        <div class="position-relative mt-4" style="max-width: 600px; margin: 0 auto;">
            <input type="text" class="form-control form-control-lg shadow-sm ps-5 rounded-pill"
                placeholder="Search books, journals, articles...">
            <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
            <button class="btn btn-primary position-absolute top-0 end-0 m-1 rounded-pill px-4">Search</button>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="list-group rounded-4 shadow-sm border-0">
            <a href="#" class="list-group-item list-group-item-action active py-3 fw-bold" aria-current="true">
                <i class="fas fa-book-open me-2"></i> All Resources
            </a>
            <a href="#" class="list-group-item list-group-item-action py-3">
                <i class="fas fa-book me-2"></i> E-Books
