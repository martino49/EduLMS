<aside class="finance-sidebar" id="financeSidebar">
    <!-- Finance Profile Section -->
    <div class="sidebar-finance-header">
        <div class="finance-badge">TREASURY</div>
        <div class="finance-avatar-wrapper">
            <div class="avatar-border"></div>
            <img src="<%= (currentUser && currentUser.profile_image) || '/images/avatars/default.png' %>" alt="Finance"
                class="finance-avatar-img">
            <div class="status-indicator online"></div>
        </div>
        <div class="finance-info">
            <h6 class="finance-name">
                <%= currentUser ? currentUser.name : 'Finance Officer' %>
            </h6>
            <div class="finance-rank">
                <%= (currentUser && currentUser.employee_id) || 'Accountant' %>
            </div>
        </div>
    </div>

    <div class="sidebar-divider"></div>

    <!-- Navigation Scroller -->
    <div class="sidebar-scroller">
        <nav class="finance-nav">
            <!-- CORE -->
            <div class="nav-section">
                <span class="section-tag">Fiscal Core</span>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>"
                            href="/finance/dashboard">
                            <span class="nav-icon-box"><i class="fas fa-chart-mixed"></i></span>
                            <span class="nav-link-text">Fiscal Dashboard</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- PAYMENTS -->
            <div class="nav-section">
                <span class="section-tag">Transactions</span>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'payments' ? 'active' : '' %>" href="/finance/payments">
                            <span class="nav-icon-box"><i class="fas fa-receipt"></i></span>
                            <span class="nav-link-text">Payment Ledger</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'fees' ? 'active' : '' %>" href="/finance/fee-structure">
                            <span class="nav-icon-box"><i class="fas fa-file-invoice-dollar"></i></span>
                            <span class="nav-link-text">Billing Config</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- REPORTS -->
            <div class="nav-section">
                <span class="section-tag">Auditing</span>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'reports' ? 'active' : '' %>" href="/finance/reports">
                            <span class="nav-icon-box"><i class="fas fa-file-chart-pie"></i></span>
                            <span class="nav-link-text">Revenue Analysis</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>

    <!-- Finance Liquidity Footer -->
    <div class="sidebar-liquidity-footer">
    </div>
</aside>

<style>
    :root {
        --fin-bg: #18181b;
        /* Zinc 900 */
        --fin-accent: #f59e0b;
        /* Amber 500 */
        --fin-text: #a1a1aa;
        --fin-bright: #fafafa;
        --fin-border: rgba(245, 158, 11, 0.1);
    }

    .finance-sidebar {
        width: 280px;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        background: var(--fin-bg);
        display: flex;
        flex-direction: column;
        color: var(--fin-text);
        z-index: 1000;
        font-family: 'Inter', sans-serif;
        border-right: 1px solid var(--fin-border);
    }

    /* HEADER STYLE */
    .sidebar-finance-header {
        padding: 2.5rem 1.5rem 1.75rem;
        position: relative;
    }

    .finance-badge {
        position: absolute;
        top: 1rem;
        left: 1.5rem;
        font-size: 0.55rem;
        font-weight: 900;
        letter-spacing: 1.5px;
        color: var(--fin-bright);
        background: var(--fin-accent);
        padding: 2px 8px;
        border-radius: 4px;
        box-shadow: 0 4px 10px rgba(245, 158, 11, 0.3);
    }

    .finance-avatar-wrapper {
        position: relative;
        width: 54px;
        height: 54px;
        margin-bottom: 1rem;
    }

    .avatar-border {
        position: absolute;
        inset: -4px;
        border: 1px solid var(--fin-accent);
        border-radius: 8px;
        opacity: 0.4;
    }

    .finance-avatar-img {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        object-fit: cover;
        border: 2px solid var(--fin-bg);
    }

    .status-indicator {
        position: absolute;
        bottom: -4px;
        right: -4px;
        width: 12px;
        height: 12px;
        background: #10b981;
        border: 2px solid var(--fin-bg);
        border-radius: 50%;
    }

    .finance-name {
        color: var(--fin-bright);
        font-weight: 700;
        margin-bottom: 0.1rem;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
    }

    .finance-rank {
        font-size: 0.7rem;
        opacity: 0.6;
        font-weight: 500;
    }

    .sidebar-divider {
        height: 1px;
        background: var(--fin-border);
        margin: 0 1.5rem;
    }

    /* NAVIGATION */
    .sidebar-scroller {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem 0.75rem;
    }

    .nav-section {
        margin-bottom: 1.75rem;
    }

    .section-tag {
        display: block;
        font-size: 0.6rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #52525b;
        margin-bottom: 0.75rem;
        padding-left: 0.75rem;
    }

    .nav-list {
        list-style: none;
        padding: 0;
    }

    .nav-item {
        margin-bottom: 4px;
    }

    .nav-link {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        border-radius: 8px;
        color: var(--fin-text);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .nav-link:hover {
        background: rgba(245, 158, 11, 0.05);
        color: var(--fin-accent);
    }

    .nav-link.active {
        background: rgba(245, 158, 11, 0.1);
        color: var(--fin-accent);
        font-weight: 600;
    }

    .nav-icon-box {
        width: 28px;
        font-size: 1rem;
    }

    .nav-link-text {
        flex: 1;
        font-size: 0.85rem;
    }

    .nav-link-badge {
        font-size: 0.65rem;
        font-weight: 800;
        background: var(--fin-accent);
        color: var(--fin-bg);
        padding: 1px 6px;
        border-radius: 4px;
    }

    /* FOOTER LIQUIDITY */
    .sidebar-liquidity-footer {
        padding: 1.5rem;
        background: rgba(0, 0, 0, 0.3);
    }

    .liquidity-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--fin-border);
        border-radius: 12px;
        padding: 14px;
        display: flex;
        flex-direction: column;
    }

    .liq-label {
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 1px;
        color: #71717a;
        margin-bottom: 4px;
    }

    .liq-value {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--fin-bright);
        font-family: 'Outfit', sans-serif;
    }

    .liq-trend {
        font-size: 0.65rem;
        font-weight: 700;
        margin-top: 4px;
    }

    .liq-trend.pos {
        color: #10b981;
    }
</style>