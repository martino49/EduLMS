<aside class="student-sidebar" id="studentSidebar">
    <!-- Student Profile Section -->
    <div class="sidebar-student-header">
        <div class="student-badge">STUDENT</div>
        <div class="student-avatar-wrapper">
            <div class="avatar-ring"></div>
            <img src="<%= (currentUser && currentUser.profile_image) || '/images/avatars/default.png' %>" alt="Student"
                class="student-avatar-img">
            <div class="status-indicator online"></div>
        </div>
        <div class="student-info">
            <h6 class="student-name">
                <%= currentUser ? currentUser.name : 'Unknown Student' %>
            </h6>
            <div class="student-identifier">ID: <%= currentUser && currentUser.student_id ? currentUser.student_id
                    : 'N/A' %>
            </div>
        </div>
        <button class="sidebar-toggle-btn" onclick="toggleStudentSidebar()">
            <i class="fas fa-bars-staggered"></i>
        </button>
    </div>

    <!-- Navigation Scroller -->
    <div class="sidebar-scroller">
        <nav class="student-nav">
            <!-- ACADEMIC -->
            <div class="nav-section">
                <span class="section-label">Learning Space</span>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>"
                            href="/student/dashboard">
                            <span class="nav-icon-box"><i class="fas fa-home-lg-alt"></i></span>
                            <span class="nav-link-text">Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'courses' ? 'active' : '' %>" href="/student/courses">
                            <span class="nav-icon-box"><i class="fas fa-books"></i></span>
                            <span class="nav-link-text">My Courses</span>
                            <span class="nav-link-badge">4</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'enroll' ? 'active' : '' %>"
                            href="/student/courses/enroll">
                            <span class="nav-icon-box"><i class="fas fa-plus-circle"></i></span>
                            <span class="nav-link-text">Enrollment</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- PERFORMANCE -->
            <div class="nav-section">
                <span class="section-label">Performance</span>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'assignments' ? 'active' : '' %>"
                            href="/student/assignments">
                            <span class="nav-icon-box"><i class="fas fa-file-edit"></i></span>
                            <span class="nav-link-text">Assignments</span>
                            <span class="nav-link-badge alert">2</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'grades' ? 'active' : '' %>" href="/student/grades">
                            <span class="nav-icon-box"><i class="fas fa-chart-user"></i></span>
                            <span class="nav-link-text">Gradebook</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- FISCAL -->
            <div class="nav-section">
                <span class="section-label">Financials</span>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'payments' ? 'active' : '' %>" href="/student/payments">
                            <span class="nav-icon-box"><i class="fas fa-wallet"></i></span>
                            <span class="nav-link-text">Financials</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>

    <!-- Student Quick Stats -->
    <div class="sidebar-quick-metrics">
        <div class="metric-card">
            <div class="metric-icon"><i class="fas fa-star text-warning"></i></div>
            <div class="metric-data">
                <span class="metric-title">CURRENT GPA</span>
                <span class="metric-value">4.0</span>
            </div>
        </div>
    </div>
</aside>

<style>
    :root {
        --std-bg: #1e1b4b;
        /* Deep Indigo */
        --std-accent: #818cf8;
        --std-text: #a5b4fc;
        --std-bright: #ffffff;
        --std-border: rgba(129, 140, 248, 0.1);
    }

    .student-sidebar {
        width: 280px;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        background: var(--std-bg);
        display: flex;
        flex-direction: column;
        color: var(--std-text);
        z-index: 1000;
        font-family: 'Inter', sans-serif;
        border-right: 1px solid var(--std-border);
    }

    /* HEADER STYLE */
    .sidebar-student-header {
        padding: 2.5rem 2rem 2rem;
        text-align: center;
        position: relative;
        border-bottom: 1px solid var(--std-border);
    }

    .student-badge {
        position: absolute;
        top: 1rem;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 2px;
        background: rgba(129, 140, 248, 0.2);
        color: var(--std-accent);
        padding: 2px 10px;
        border-radius: 4px;
    }

    .student-avatar-wrapper {
        position: relative;
        width: 90px;
        height: 90px;
        margin: 0 auto 1rem;
    }

    .avatar-ring {
        position: absolute;
        inset: -5px;
        border: 2px solid var(--std-accent);
        border-radius: 50%;
        opacity: 0.3;
        border-style: dashed;
        animation: rotate-ring 10s linear infinite;
    }

    @keyframes rotate-ring {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .student-avatar-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--std-bg);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }

    .status-indicator {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 14px;
        height: 14px;
        background: #10b981;
        border: 3px solid var(--std-bg);
        border-radius: 50%;
    }

    .student-name {
        color: var(--std-bright);
        font-weight: 700;
        margin-bottom: 0.25rem;
        font-family: 'Outfit', sans-serif;
        font-size: 1.1rem;
    }

    .student-identifier {
        font-size: 0.75rem;
        opacity: 0.6;
        font-weight: 500;
        letter-spacing: 0.5px;
    }

    .sidebar-toggle-btn {
        position: absolute;
        right: 1rem;
        top: 1rem;
        background: none;
        border: none;
        color: var(--std-text);
        cursor: pointer;
        display: none;
        /* Desktop hidden */
    }

    /* NAVIGATION */
    .sidebar-scroller {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem 1rem;
    }

    .nav-section {
        margin-bottom: 2rem;
    }

    .section-label {
        display: block;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: rgba(165, 180, 252, 0.4);
        margin-bottom: 0.75rem;
        padding-left: 0.5rem;
    }

    .nav-list {
        list-style: none;
        padding: 0;
    }

    .nav-item {
        margin-bottom: 6px;
    }

    .nav-link {
        display: flex;
        align-items: center;
        padding: 12px 14px;
        border-radius: 12px;
        color: var(--std-text);
        text-decoration: none;
        transition: all 0.2s ease;
        background: transparent;
    }

    .nav-link:hover {
        background: rgba(129, 140, 248, 0.05);
        color: var(--std-bright);
        transform: translateX(4px);
    }

    .nav-link.active {
        background: linear-gradient(90deg, rgba(129, 140, 248, 0.1) 0%, rgba(129, 140, 248, 0) 100%);
        color: var(--std-accent);
        border-left: 3px solid var(--std-accent);
    }

    .nav-icon-box {
        width: 32px;
        font-size: 1.1rem;
    }

    .nav-link-text {
        flex: 1;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .nav-link-badge {
        background: rgba(129, 140, 248, 0.2);
        color: var(--std-accent);
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .nav-link-badge.alert {
        background: #ef4444;
        color: white;
    }

    /* METRICS */
    .sidebar-quick-metrics {
        padding: 1.5rem;
        background: rgba(0, 0, 0, 0.2);
        border-top: 1px solid var(--std-border);
    }

    .metric-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--std-border);
        border-radius: 12px;
        padding: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .metric-icon {
        font-size: 1.2rem;
    }

    .metric-data {
        display: flex;
        flex-direction: column;
    }

    .metric-title {
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 1px;
        opacity: 0.5;
    }

    .metric-value {
        font-size: 1rem;
        font-weight: 700;
        color: var(--std-bright);
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
        .student-sidebar {
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }

        .student-sidebar.open {
            transform: translateX(0);
        }
    }
</style>

<script>
    function toggleStudentSidebar() {
        const sidebar = document.getElementById('studentSidebar');
        sidebar.classList.toggle('open');
    }
</script>