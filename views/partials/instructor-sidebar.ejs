<aside class="instructor-sidebar" id="instructorSidebar">
    <!-- Instructor Profile Section -->
    <div class="sidebar-instructor-header">
        <div class="instructor-badge">INSTRUCTOR</div>
        <div class="instructor-avatar-wrapper">
            <div class="avatar-glow"></div>
            <img src="<%= (currentUser && currentUser.profile_image) || '/images/avatars/default.png' %>"
                alt="Instructor" class="instructor-avatar-img">
            <div class="status-indicator online"></div>
        </div>
        <div class="instructor-info">
            <h6 class="instructor-name">
                <%= currentUser ? currentUser.name : 'Professor' %>
            </h6>
            <div class="instructor-dept">
                <%= (currentUser && currentUser.department) || 'Academic Faculty' %>
            </div>
        </div>
    </div>

    <div class="sidebar-divider"></div>

    <!-- Navigation Scroller -->
    <div class="sidebar-scroller">
        <nav class="instructor-nav">
            <!-- CORE -->
            <div class="nav-section">
                <span class="section-label">Command Center</span>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>"
                            href="/instructor/dashboard">
                            <span class="nav-icon-box"><i class="fas fa-radar"></i></span>
                            <span class="nav-link-text">Overview</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- ACADEMIC -->
            <div class="nav-section">
                <span class="section-label">Academic Management</span>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'courses' ? 'active' : '' %>" href="/instructor/courses">
                            <span class="nav-icon-box"><i class="fas fa-chalkboard"></i></span>
                            <span class="nav-link-text">My Courses</span>
                            <span class="nav-link-badge">8</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'assignments' ? 'active' : '' %>"
                            href="/instructor/assignments">
                            <span class="nav-icon-box"><i class="fas fa-tasks-alt"></i></span>
                            <span class="nav-link-text">Assignments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'submissions' ? 'active' : '' %>"
                            href="/instructor/submissions">
                            <span class="nav-icon-box"><i class="fas fa-inbox-out"></i></span>
                            <span class="nav-link-text">Submissions</span>
                            <span class="nav-link-badge pulse alert">12</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- PERFORMANCE -->
            <div class="nav-section">
                <span class="section-label">Analytics</span>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'gradebook' ? 'active' : '' %>"
                            href="/instructor/gradebook">
                            <span class="nav-icon-box"><i class="fas fa-chart-network"></i></span>
                            <span class="nav-link-text">Gradebook</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPage === 'analytics' ? 'active' : '' %>"
                            href="/instructor/analytics">
                            <span class="nav-icon-box"><i class="fas fa-chart-line"></i></span>
                            <span class="nav-link-text">Performance</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>

    <!-- Instructor Analytics Footer -->
    <div class="sidebar-stats-footer">
        <div class="stat-row">
            <div class="stat-box">
                <span class="stat-val">12</span>
                <span class="stat-lab">Pending</span>
            </div>
            <div class="stat-box">
                <span class="stat-val">98%</span>
                <span class="stat-lab">Pass Rate</span>
            </div>
        </div>
    </div>
</aside>

<style>
    :root {
        --inst-bg: #064e3b;
        /* Deep Emerald */
        --inst-accent: #10b981;
        --inst-text: #a7f3d0;
        --inst-bright: #ffffff;
        --inst-border: rgba(16, 185, 129, 0.1);
    }

    .instructor-sidebar {
        width: 280px;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        background: var(--inst-bg);
        display: flex;
        flex-direction: column;
        color: var(--inst-text);
        z-index: 1000;
        font-family: 'Inter', sans-serif;
        border-right: 1px solid var(--inst-border);
    }

    /* HEADER STYLE */
    .sidebar-instructor-header {
        padding: 2.5rem 1.5rem 1.5rem;
        position: relative;
        background: rgba(0, 0, 0, 0.1);
    }

    .instructor-badge {
        position: absolute;
        top: 1rem;
        right: 1.5rem;
        font-size: 0.55rem;
        font-weight: 900;
        letter-spacing: 1px;
        color: var(--inst-accent);
        background: rgba(16, 185, 129, 0.1);
        padding: 2px 8px;
        border-radius: 4px;
    }

    .instructor-avatar-wrapper {
        position: relative;
        width: 60px;
        height: 60px;
        margin-bottom: 1rem;
    }

    .avatar-glow {
        position: absolute;
        inset: -10px;
        background: var(--inst-accent);
        filter: blur(20px);
        opacity: 0.2;
        border-radius: 50%;
    }

    .instructor-avatar-img {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        object-fit: cover;
        border: 2px solid rgba(255, 255, 255, 0.1);
        position: relative;
        z-index: 1;
    }

    .status-indicator {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 12px;
        height: 12px;
        background: #10b981;
        border: 2px solid var(--inst-bg);
        border-radius: 50%;
        z-index: 2;
    }

    .instructor-info {
        position: relative;
        z-index: 1;
    }

    .instructor-name {
        color: var(--inst-bright);
        font-weight: 700;
        margin-bottom: 0.15rem;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
    }

    .instructor-dept {
        font-size: 0.7rem;
        opacity: 0.6;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .sidebar-divider {
        height: 1px;
        background: var(--inst-border);
        margin: 0 1.5rem;
    }

    /* NAVIGATION */
    .sidebar-scroller {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem 0.75rem;
    }

    .sidebar-scroller::-webkit-scrollbar {
        width: 3px;
    }

    .sidebar-scroller::-webkit-scrollbar-thumb {
        background: var(--inst-border);
    }

    .nav-section {
        margin-bottom: 1.5rem;
    }

    .section-label {
        display: block;
        font-size: 0.6rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #0d9488;
        margin-bottom: 0.75rem;
        padding-left: 0.75rem;
    }

    .nav-list {
        list-style: none;
        padding: 0;
    }

    .nav-item {
        margin-bottom: 4px;
    }

    .nav-link {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        border-radius: 10px;
        color: var(--inst-text);
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-link:hover {
        background: rgba(16, 185, 129, 0.05);
        color: var(--inst-bright);
    }

    .nav-link.active {
        background: var(--inst-accent);
        color: white;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .nav-icon-box {
        width: 28px;
        font-size: 1rem;
    }

    .nav-link-text {
        flex: 1;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .nav-link-badge {
        font-size: 0.65rem;
        font-weight: 700;
        background: rgba(255, 255, 255, 0.1);
        padding: 2px 6px;
        border-radius: 4px;
    }

    .nav-link-badge.alert {
        background: #f59e0b;
        color: white;
    }

    .pulse.alert {
        animation: alert-pulse 2s infinite;
    }

    @keyframes alert-pulse {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7);
        }

        70% {
            transform: scale(1.05);
            box-shadow: 0 0 0 10px rgba(245, 158, 11, 0);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(245, 158, 11, 0);
        }
    }

    /* FOOTER STATS */
    .sidebar-stats-footer {
        padding: 1.25rem 1.75rem;
        background: rgba(0, 0, 0, 0.2);
        border-top: 1px solid var(--inst-border);
    }

    .stat-row {
        display: flex;
        gap: 1.5rem;
    }

    .stat-box {
        display: flex;
        flex-direction: column;
    }

    .stat-val {
        font-size: 1rem;
        font-weight: 800;
        color: var(--inst-bright);
    }

    .stat-lab {
        font-size: 0.55rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        opacity: 0.5;
    }
</style>