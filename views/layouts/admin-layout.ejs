<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'Admin - EduLMS' %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --primary: #4e73df;
            --primary-light: #7a9ff9;
            --primary-dark: #2653c4;
            --success: #1cc88a;
            --success-light: #4ae0a7;
            --warning: #f6c23e;
            --warning-light: #f8d470;
            --info: #36b9cc;
            --info-light: #5ccfdf;
            --danger: #e74a3b;
            --dark: #1e293b;
            --light: #f8f9fc;
            --sidebar-width: 280px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f1f5f9;
            font-family: 'Inter', sans-serif;
            color: var(--dark);
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        .brand-name {
            font-family: 'Outfit', sans-serif;
        }

        /* Admin Layout */
        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* Main Content */
        .admin-main {
            flex: 1;
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header */
        .admin-header {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 0.75rem 2rem;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-title h1 {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--dark);
            margin: 0;
        }

        .user-menu {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.8rem;
        }

        /* Page Content */
        .admin-content {
            padding: 1.5rem;
        }

        /* Footer */
        .admin-footer {
            background: #fff;
            border-top: 1px solid #e3e6f0;
            padding: 1rem 2rem;
            text-align: center;
            color: #6c757d;
            font-size: 0.75rem;
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .admin-sidebar {
                transform: translateX(-100%);
                position: fixed;
                top: 0;
                left: 0;
                height: 100vh;
                z-index: 1000;
            }

            .admin-sidebar.show {
                transform: translateX(0);
            }

            .admin-main {
                margin-left: 0;
            }

            .mobile-menu-btn {
                display: block;
                background: none;
                border: none;
                color: var(--dark);
                font-size: 1.1rem;
                cursor: pointer;
            }
        }
    </style>
</head>

<body>
    <div class="admin-layout">
        <%- include('../partials/admin-sidebar', { currentPage: typeof currentPage !=='undefined' ? currentPage : '' ,
            currentUser: typeof currentUser !=='undefined' ? currentUser : (typeof user !=='undefined' ? user : null) })
            %>

            <div class="admin-main">
                <%- include('../partials/admin-header', { currentUser: typeof currentUser !=='undefined' ? currentUser :
                    (typeof user !=='undefined' ? user : null) }) %>

                    <main class="admin-content">
                        <%- include('../partials/flash-messages', { messages: typeof messages !=='undefined' ? messages
                            : {} }) %>
                            <%- body %>
                    </main>

                    <%- include('../partials/footer') %>
            </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.querySelector('.admin-sidebar');
            sidebar.classList.toggle('show');
        }
    </script>
</body>

</html>