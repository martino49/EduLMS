    <div class="row">
        <div class="col-md-3 mb-4">
            <h5 class="fw-bold mb-3">For Students</h5>
            <ul class="list-unstyled">
                <li class="mb-2"><a href="/courses" class="text-muted text-decoration-none hover-lift d-inline-block"><i
                            class="fas fa-book me-2"></i>Browse Courses</a></li>
                <li class="mb-2"><a href="/programs"
                        class="text-muted text-decoration-none hover-lift d-inline-block"><i
                            class="fas fa-graduation-cap me-2"></i>Programs</a></li>
                <li class="mb-2"><a href="/library" class="text-muted text-decoration-none hover-lift d-inline-block"><i
                            class="fas fa-book-reader me-2"></i>Library</a></li>
                <li class="mb-2"><a href="/calendar"
                        class="text-muted text-decoration-none hover-lift d-inline-block"><i
                            class="fas fa-calendar me-2"></i>Calendar</a></li>
            </ul>
        </div>
        <div class="col-md-3 mb-4">
            <h5 class="fw-bold mb-3">Resources</h5>
            <ul class="list-unstyled">
                <li class="mb-2"><a href="/help" class="text-muted text-decoration-none hover-lift d-inline-block"><i
                            class="fas fa-question-circle me-2"></i>Help Center</a></li>
                <li class="mb-2"><a href="/about" class="text-muted text-decoration-none hover-lift d-inline-block"><i
                            class="fas fa-info-circle me-2"></i>About Us</a></li>
                <li class="mb-2"><a href="/contact" class="text-muted text-decoration-none hover-lift d-inline-block"><i
                            class="fas fa-envelope me-2"></i>Contact</a></li>
                <li class="mb-2"><a href="/features"
                        class="text-muted text-decoration-none hover-lift d-inline-block"><i
                            class="fas fa-star me-2"></i>Features</a></li>
            </ul>
        </div>
        <div class="col-md-3 mb-4">
            <h5 class="fw-bold mb-3">Legal</h5>
            <ul class="list-unstyled">
                <li class="mb-2"><a href="/privacy" class="text-muted text-decoration-none hover-lift d-inline-block"><i
                            class="fas fa-shield-alt me-2"></i>Privacy Policy</a></li>
                <li class="mb-2"><a href="/terms" class="text-muted text-decoration-none hover-lift d-inline-block"><i
                            class="fas fa-file-contract me-2"></i>Terms of Service</a></li>
            </ul>
        </div>
        <div class="col-md-3 mb-4">
            <h5 class="fw-bold mb-3">Connect</h5>
            <div class="d-flex gap-3">
                <a href="#" class="text-muted hover-lift"><i class="fab fa-facebook fa-2x"></i></a>
                <a href="#" class="text-muted hover-lift"><i class="fab fa-twitter fa-2x"></i></a>
                <a href="#" class="text-muted hover-lift"><i class="fab fa-linkedin fa-2x"></i></a>
                <a href="#" class="text-muted hover-lift"><i class="fab fa-instagram fa-2x"></i></a>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Animate stats on scroll
        const observerOptions = {
            threshold: 0.5
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const statNumbers = entry.target.querySelectorAll('.stat-number');
                    statNumbers.forEach(stat => {
                        const finalValue = stat.textContent;
                        stat.style.opacity = '0';
                        setTimeout(() => {
                            stat.style.transition = 'opacity 0.5s ease';
                            stat.style.opacity = '1';
                        }, 100);
                    });
                }
            });
        }, observerOptions);

        const statsSection = document.querySelector('.stats-section');
        if (statsSection) {
            observer.observe(statsSection);
        }
    });
</script>