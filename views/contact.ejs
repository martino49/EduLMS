<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <h1 class="display-4 mb-3">Get in Touch</h1>
                <p class="lead text-muted">Have questions? We're here to help you navigate EduLMS.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-5">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 h-xl-100">
                        <h4 class="mb-4">Contact Info</h4>
                        <div class="d-flex mb-3">
                            <i class="fas fa-map-marker-alt text-primary me-3 mt-1"></i>
                            <div>
                                <h6 class="mb-1">HQ Address</h6>
                                <p class="text-muted small">Nairobi, Kenya</p>
                            </div>
                        </div>
                        <div class="d-flex mb-3">
                            <i class="fas fa-phone text-primary me-3 mt-1"></i>
                            <div>
                                <h6 class="mb-1">Phone</h6>
                                <p class="text-muted small">+254 700 000 000</p>
                            </div>
                        </div>
                        <div class="d-flex mb-3">
                            <i class="fas fa-envelope text-primary me-3 mt-1"></i>
                            <div>
                                <h6 class="mb-1">Email</h6>
                                <p class="text-muted small">support@edulms.com</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <form>
                            <div class="mb-3">
                                <label class="form-label">Full Name</label>
                                <input type="text" class="form-control" placeholder="Enter your name">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email Address</label>
                                <input type="email" class="form-control" placeholder="name@example.com">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Message</label>
                                <textarea class="form-control" rows="4" placeholder="How can we help you?"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>